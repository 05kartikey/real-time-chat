# Server configuration (read by server/config/env.js, validated at boot)
NODE_ENV=development
PORT=5000

# Allowed browser origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/realtime-chat

# Redis (Redis Cloud / Upstash free tier, or a local Redis/Memurai).
# Optional in development: leave empty to use in-memory stores (single instance only).
REDIS_URL=redis://default:<password>@<host>:<port>

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cloudinary (Dashboard → API Keys).
# Optional in development: leave empty and file/avatar uploads are disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
